# ============================================================
# CLIPCRAFT STUDIO - SHORT-FORM CREATOR WORKFLOW
# ============================================================
# Copy this file to .env and fill in your keys.
# NEVER commit the real .env file to GitHub.
# ============================================================

# --- Baseten hosted Meta model ---
# Add your Baseten API key as MODEL_API_KEY. Keep it server-side and out of Git.
MODEL_API_KEY=your_baseten_api_key_here
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1

# --- YouTube Data API v3 ---
# Get your free key at: https://console.cloud.google.com/
# Enable "YouTube Data API v3" for your project.
# Required for competitor trend searches and public channel video statistics.
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Supabase ---
# Get from: https://supabase.com/ -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Your YouTube Channel ID ---
# Found in YouTube Studio -> Customization -> Basic Info
YOUR_CHANNEL_ID=UCb_5KqvTJQEVoT-8wI17cDA

# --- Optional future research integrations ---
# These are not used by the current researcher yet. Add them only when the
# corresponding official API collectors are implemented.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=oddly-possible-research/1.0 by your_reddit_username
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
META_ACCESS_TOKEN=your_meta_graph_api_token
META_PAGE_ACCESS_TOKEN=your_page_access_token_optional
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# --- App Config ---
# Set to "production" when deploying to Render
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
